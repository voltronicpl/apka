<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_bell_launcher" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Title"
                    android:layout_width="wrap_content"
                    android:text="Sekurak" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alarm z Home Assistant"
                    android:textColor="@color/text_sub" />
            </LinearLayout>
        </LinearLayout>

        <!-- Typy alarmów – wstawiane z kodu (item_type.xml) -->
        <LinearLayout
            android:id="@+id/typesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- WSPÓLNE -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Section" android:text="🔊  Wspólne dla wszystkich alarmów" />

            <TextView
                android:id="@+id/tvVolume"
                style="@style/Info"
                android:textColor="@color/text" />

            <SeekBar
                android:id="@+id/sbVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swForce"
                style="@style/Sw"
                android:text="Wymuś tę głośność na czas alarmu" />

            <TextView
                style="@style/Info"
                android:layout_marginTop="12dp"
                android:text="Automatyczne wyłączenie po (minuty, 0 = nigdy):" />

            <EditText
                android:id="@+id/etAutoStop"
                style="@style/Field"
                android:inputType="number" />
        </LinearLayout>

        <!-- WEBHOOK -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Section" android:text="🏠  Powrót do Home Assistant" />

            <TextView
                style="@style/Info"
                android:text="Po wyciszeniu alarmu Sekurak wywoła ten webhook, a HA wyłączy właściwy przełącznik." />

            <EditText
                android:id="@+id/etWebhook"
                style="@style/Field"
                android:hint="https://pusiloft.ovh/api/webhook/…"
                android:inputType="textUri" />

            <Button
                android:id="@+id/btnTestWebhook"
                style="@style/Btn"
                android:text="Testuj webhook" />

            <TextView
                android:id="@+id/tvWebhookStatus"
                style="@style/Info" />
        </LinearLayout>

        <!-- SEKRET -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Section" android:text="🔒  Sekret (opcjonalnie)" />

            <TextView
                style="@style/Info"
                android:text="Jeśli wpiszesz sekret, alarm odpali tylko sygnał z HA z tym samym sekretem." />

            <EditText
                android:id="@+id/etSecret"
                style="@style/Field"
                android:hint="Sekret"
                android:inputType="text" />

            <Button
                android:id="@+id/btnSave"
                style="@style/Btn"
                android:text="Zapisz" />
        </LinearLayout>

        <!-- UPRAWNIENIA -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Section" android:text="🛡️  Uprawnienia" />

            <TextView
                android:id="@+id/tvPerms"
                style="@style/Info"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btnPermNotif"
                style="@style/Btn"
                android:text="Zezwól na powiadomienia" />

            <Button
                android:id="@+id/btnPermFull"
                style="@style/Btn"
                android:text="Zezwól na pełny ekran" />

            <Button
                android:id="@+id/btnPermBattery"
                style="@style/Btn"
                android:text="Wyłącz optymalizację baterii" />

            <Button
                android:id="@+id/btnPermOverlay"
                style="@style/Btn"
                android:text="Wyświetlanie nad innymi aplikacjami" />
        </LinearLayout>

        <TextView
            style="@style/Info"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Wyciszenie testu też wywoła webhook (HA wyłączy przełącznik danego typu)." />
    </LinearLayout>
</ScrollView>
