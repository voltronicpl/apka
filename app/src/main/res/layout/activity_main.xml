<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_bell_launcher" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Title"
                    android:layout_width="wrap_content"
                    android:text="Sekurak" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alarm z Home Assistant"
                    android:textColor="@color/text_sub" />
            </LinearLayout>
        </LinearLayout>

        <!-- DŹWIĘK -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Section" android:text="🔔  Dzwonek i wibracje" />

            <TextView
                android:id="@+id/tvRingtone"
                style="@style/Info"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btnPickRingtone"
                style="@style/Btn"
                android:text="Wybierz dzwonek systemowy" />

            <Button
                android:id="@+id/btnPickFile"
                style="@style/Btn"
                android:text="Wybierz własny plik audio" />

            <Button
                android:id="@+id/btnDefaultRingtone"
                style="@style/Btn"
                android:text="Przywróć domyślny" />

            <TextView
                android:id="@+id/tvVolume"
                style="@style/Info"
                android:layout_marginTop="16dp"
                android:textColor="@color/text" />

            <SeekBar
                android:id="@+id/sbVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swForce"
                style="@style/Sw"
                android:text="Wymuś tę głośność na czas alarmu" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swVibrate"
                style="@style/Sw"
                android:text="Wibracje" />

            <TextView
                style="@style/Info"
                android:layout_marginTop="12dp"
                android:text="Automatyczne wyłączenie po (minuty, 0 = nigdy):" />

            <EditText
                android:id="@+id/etAutoStop"
                style="@style/Field"
                android:inputType="number" />
        </LinearLayout>

        <!-- BEZPIECZEŃSTWO -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Section" android:text="🔒  Sekret (opcjonalnie)" />

            <TextView
                style="@style/Info"
                android:text="Jeśli wpiszesz sekret, alarm odpali tylko sygnał z HA z tym samym sekretem." />

            <EditText
                android:id="@+id/etSecret"
                style="@style/Field"
                android:hint="Sekret"
                android:inputType="text" />

            <Button
                android:id="@+id/btnSave"
                style="@style/Btn"
                android:text="Zapisz" />
        </LinearLayout>

        <!-- UPRAWNIENIA -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Section" android:text="🛡️  Uprawnienia" />

            <TextView
                android:id="@+id/tvPerms"
                style="@style/Info"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btnPermNotif"
                style="@style/Btn"
                android:text="Zezwól na powiadomienia" />

            <Button
                android:id="@+id/btnPermFull"
                style="@style/Btn"
                android:text="Zezwól na pełny ekran" />

            <Button
                android:id="@+id/btnPermBattery"
                style="@style/Btn"
                android:text="Wyłącz optymalizację baterii" />

            <Button
                android:id="@+id/btnPermOverlay"
                style="@style/Btn"
                android:text="Wyświetlanie nad innymi aplikacjami" />
        </LinearLayout>

        <!-- COMPANION -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Section" android:text="🏠  Companion App HA" />

            <TextView
                style="@style/Info"
                android:lineSpacingExtra="3dp"
                android:text="W aplikacji Home Assistant: Ustawienia → Companion App → Zarządzaj czujnikami → Last update trigger → włącz i dodaj intenty:\n\npl.sekurak.ALARM\npl.sekurak.KONIEC"
                android:textIsSelectable="true" />

            <TextView
                style="@style/Info"
                android:layout_marginTop="12dp"
                android:text="Test: kliknij i sprawdź w HA stan sensor.misiekfon_last_update_trigger" />

            <Button
                android:id="@+id/btnSendAlarm"
                style="@style/Btn"
                android:text="Wyślij ALARM do HA" />

            <Button
                android:id="@+id/btnSendKoniec"
                style="@style/Btn"
                android:text="Wyślij KONIEC do HA" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTestAlarm"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_stop_button"
            android:text="TESTUJ ALARM"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Info"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Wyciszenie testu też wyśle KONIEC do HA." />
    </LinearLayout>
</ScrollView>
